<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="1" author="fineract">
        <createTable tableName="m_statement_of_account">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="BIGINT"/>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="debit_amount" type="DECIMAL(19,6)"/>
            <column name="credit_amount" type="DECIMAL(19,6)"/>
            <column name="principal" type="DECIMAL(19,6)"/>
            <column name="interest" type="DECIMAL(19,6)"/>
            <column name="fees" type="DECIMAL(19,6)"/>
            <column name="penalty" type="DECIMAL(19,6)"/>
            <column name="outstanding_balance" type="DECIMAL(19,6)"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="created_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="loan_id"
                                 baseTableName="m_statement_of_account"
                                 constraintName="FK_m_soa_m_loan"
                                 referencedColumnNames="id"
                                 referencedTableName="m_loan"/>
                                 
        <addForeignKeyConstraint baseColumnNames="client_id"
                                 baseTableName="m_statement_of_account"
                                 constraintName="FK_m_soa_m_client"
                                 referencedColumnNames="id"
                                 referencedTableName="m_client"/>
                                 
        <addForeignKeyConstraint baseColumnNames="transaction_id"
                                 baseTableName="m_statement_of_account"
                                 constraintName="FK_m_soa_m_loan_transaction"
                                 referencedColumnNames="id"
                                 referencedTableName="m_loan_transaction"/>
    </changeSet>

</databaseChangeLog>
